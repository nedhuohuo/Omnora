# Copy to deploy/aliyun-test.env on the Aliyun ECS host.
# Do not commit the real env file; it contains one-time setup secrets.

COMPOSE_PROJECT_NAME=omnora-aliyun-test
PUID=1000
PGID=1000
TZ=Asia/Shanghai
UMASK=0027
# Use the verified regional module mirror when the ECS cannot reach proxy.golang.org.
GOPROXY=https://goproxy.cn,direct

# Fill these from the private operator vault after confirming the Aliyun ECS instance
# is still owned by you and has no production workload.
OMNORA_TEST_SERVER_NAME=aliyun-ecs-test
OMNORA_TEST_SERVER_HOST=replace-with-private-vault-host
OMNORA_TEST_SERVER_SSH_PORT=22
OMNORA_TEST_SERVER_SSH_USER=root

# Current Aliyun test-box access: public HTTP on 8080 for external browsers.
# Example: http://<public-host>:8080
OMNORA_BIND=0.0.0.0
OMNORA_LOG_FORMAT=json
OMNORA_LOG_LEVEL=info
OMNORA_LOG_MAX_SIZE=10m
OMNORA_LOG_MAX_FILE=5

# Keep public route groups closed on the test box unless firewall rules allow them.
# Share is enabled on the QA test box so share links can be exercised; the
# UI refuses to create a share while this group is disabled (see createShare).
OMNORA_ROUTE_ADMIN_WEB_ENABLED=true
OMNORA_ROUTE_MEMBER_WEB_ENABLED=true
OMNORA_ROUTE_SHARE_ENABLED=true
OMNORA_ROUTE_REST_ENABLED=true
OMNORA_ROUTE_MCP_ENABLED=false
OMNORA_ROUTE_OPENAPI_ENABLED=true

# Optional. Leave blank to let the container generate and persist a one-time
# bootstrap token in aliyun-test/config/runtime.env. Set it explicitly if the
# first setup flow must use a known token.
OMNORA_INITIALIZATION_TOKEN=
OMNORA_INITIALIZATION_TOKEN_TTL=30m
# Optional. Leave blank to let the container generate and persist a 64-character
# random encryption key in aliyun-test/config/runtime.env. Set a stable value
# explicitly only when restoring an existing Omnora data directory.
OMNORA_TOTP_ENCRYPTION_KEY=
